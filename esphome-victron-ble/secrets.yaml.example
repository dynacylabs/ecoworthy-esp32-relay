# Copy to secrets.yaml and fill in real values. secrets.yaml is gitignored.
wifi_ssid: "changeme"
wifi_password: "changeme"
gateway: "192.168.2.1"
subnet: "255.255.255.0"

# Generate a fresh API encryption key / OTA password with:
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
#   python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(24)))"
static_ip: "192.168.2.5"
api_encryption_key: "changeme"
ota_password: "changeme"

# The Victron SmartSolar MPPT's own BLE identity. Get both from the
# VictronConnect app:
#   Settings -> Product info -> scroll to "Instant readout via Bluetooth"
#   -> ensure it's enabled -> "Instant readout details" -> SHOW.
# mac_address is printed there too (and on the unit's sticker/label).
# bindkey must be exactly 32 hex characters - if VictronConnect only shows
# 31, reset the device's Bluetooth PIN to get a fresh 32-character key.
victron_mac_address: "AA:BB:CC:DD:EE:FF"
victron_bindkey: "changeme0000000000000000000000"
